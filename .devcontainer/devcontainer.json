{
  // Entorno idéntico para Camila, Luis y Jessica en GitHub Codespaces.
  // Python 3.12 + Graphviz (diagramas) + pandoc (informe .docx) + GitHub CLI (PR, issues, release).
  "name": "LOGISTPULSE · Deber 2 Teoría de la Computación",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y --no-install-recommends graphviz pandoc && python -m pip install --quiet pytest && LOGISTPULSE_SIN_TIEMPOS=1 python -m unittest discover -s tests",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "python.testing.unittestEnabled": true,
        "python.testing.pytestEnabled": false,
        "python.testing.unittestArgs": ["-v", "-s", "./tests", "-t", "."],
        "files.trimTrailingWhitespace": true
      }
    },
    "codespaces": {
      "openFiles": ["equipo/GUIA_CODESPACES.md"]
    }
  }
}
